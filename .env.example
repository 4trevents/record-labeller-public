# Copy this file to .env and fill in your own values. .env is gitignored.

# Discogs personal access token — generate one at
# https://www.discogs.com/settings/developers
DISCOGS_TOKEN=
DISCOGS_USERNAME=
DISCOGS_USER_AGENT=RecordLabeller/0.1

# GetSongBPM API key — sign up at https://getsongbpm.com/api
# (requires a public backlink to getsongbpm.com; see the public repo)
GETSONGBPM_API_KEY=
